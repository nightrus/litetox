API_TOKEN=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# domain of the HTTPS API (A record -> this host; ports 80/443 open for Let's Encrypt)
DOMAIN=litetox.example.com
# default ALTOX SERVER 2.0 for the session mirror (host:port, empty = off);
# can be overridden per IMEI from Home Assistant
ALTOX_UPSTREAM=d2.altox.app:20332
# legacy /state and /cmd without IMEI map to this device (may stay empty)
DEFAULT_IMEI=
TCP_PORT=20013
# docker network shared with the reverse proxy
WEB_NETWORK=litetox-web
